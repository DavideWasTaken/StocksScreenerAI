# Required only when AI analysis is enabled.
OPENAI_API_KEY=

# Choose a Responses model that supports Structured Outputs and, when enabled, web search.
OPENAI_MODEL=gpt-5-mini

# Optional runtime defaults. CLI flags take precedence.
ND_CACHE_DIR=.cache/narrative_dislocation
ND_OUTPUT_DIR=outputs
ND_CACHE_TTL_HOURS=24
ND_MIN_MARKET_CAP=5000000000
ND_MIN_DRAWDOWN=0.25
ND_PRICE_HISTORY_YEARS=6
ND_BENCHMARK=SPY
ND_AI_WEB_SEARCH=true
ND_AI_CANDIDATES=20
ND_FINAL_TOP=20
ND_REPORT_TOP=10

# Optional local CSV path or direct HTTP(S) CSV URL.
RUSSELL_1000_SOURCE=
